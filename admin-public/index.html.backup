<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <meta name="theme-color" content="#0d47a1">
  <title>SIVT AI - Admin Dashboard</title>
  <link rel="manifest" href="/admin/manifest-admin.json">
  <link rel="icon" type="image/png" href="/uploads/logo.png">
  <link rel="stylesheet" href="/admin/style.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
  <script src="https://unpkg.com/vis-network@9.1.6/standalone/umd/vis-network.min.js"></script>
</head>
<body>

<!-- ============================================================
LOGIN PAGE
============================================================ -->
<div id="loginPage">
  <div class="login-card">
    <div class="login-logo">
      <div class="logo-icon" id="loginLogo">S</div>
      <h2 id="loginTitle">SIVT AI</h2>
      <p>Admin Dashboard</p>
    </div>
    <form onsubmit="doLogin(event)">
      <div class="form-group">
        <label>Username</label>
        <input type="text" id="loginUsername" class="form-control" placeholder="Masukkan username" required>
      </div>
      <div class="form-group">
        <label>Password</label>
        <input type="password" id="loginPassword" class="form-control" placeholder="Masukkan password" required>
      </div>
      <div id="loginError" class="text-danger" style="display:none; margin-bottom:12px; font-size:13px;"></div>
      <button type="submit" class="btn-primary-lg btn-login">
        <i class="fas fa-sign-in-alt"></i> Login
      </button>
    </form>
    <div style="text-align:center; margin-top:16px;">
      <a href="/" class="btn-back"><i class="fas fa-arrow-left"></i> Ke Halaman Warga</a>
    </div>
  </div>
</div>

<!-- ============================================================
ADMIN PAGE
============================================================ -->
<div id="adminPage">

  <!-- SIDEBAR -->
  <aside class="admin-sidebar" id="adminSidebar">
    <div class="sidebar-brand">
      <div class="brand-logo" id="sidebarLogo">S</div>
      <div class="brand-text">
        <div class="brand-name" id="sidebarAiName">SIVT AI</div>
        <div class="brand-sub">Admin Panel</div>
      </div>
    </div>

    <div class="nav-controls">
      <button class="nav-control-btn" onclick="expandAllGroups()" title="Expand Semua">
        <i class="fas fa-expand-alt"></i>
      </button>
      <button class="nav-control-btn" onclick="collapseAllGroups()" title="Collapse Semua">
        <i class="fas fa-compress-alt"></i>
      </button>
    </div>

    <nav class="sidebar-nav">

      <!-- UTAMA -->
      <div class="nav-group">
        <div class="nav-section" onclick="toggleNavGroup(this)">
          <span class="nav-section-dot"></span>
          <span class="nav-section-text">Utama</span>
          <i class="fas fa-chevron-down nav-section-chevron"></i>
        </div>
        <div class="nav-group-content">
          <div class="nav-item active" data-page="dashboard">
            <div class="nav-icon"><i class="fas fa-tachometer-alt"></i></div>
            <span class="nav-text">Dashboard</span>
          </div>
        </div>
      </div>

      <!-- KONFIGURASI -->
      <div class="nav-group">
        <div class="nav-section" onclick="toggleNavGroup(this)">
          <span class="nav-section-dot"></span>
          <span class="nav-section-text">Konfigurasi</span>
          <i class="fas fa-chevron-down nav-section-chevron"></i>
        </div>
        <div class="nav-group-content">
          <div class="nav-item" data-page="general">
            <div class="nav-icon"><i class="fas fa-cog"></i></div>
            <span class="nav-text">Umum</span>
          </div>
          <div class="nav-item" data-page="logo">
            <div class="nav-icon"><i class="fas fa-image"></i></div>
            <span class="nav-text">Logo & Branding</span>
          </div>
          <div class="nav-item" data-page="theme">
            <div class="nav-icon"><i class="fas fa-palette"></i></div>
            <span class="nav-text">Warna Tema</span>
          </div>
          <div class="nav-item" data-page="prompt">
            <div class="nav-icon"><i class="fas fa-terminal"></i></div>
            <span class="nav-text">Prompt AI</span>
          </div>
        </div>
      </div>

      <!-- PROVIDER & MODEL -->
      <div class="nav-group">
        <div class="nav-section" onclick="toggleNavGroup(this)">
          <span class="nav-section-dot"></span>
          <span class="nav-section-text">Provider & Model</span>
          <i class="fas fa-chevron-down nav-section-chevron"></i>
        </div>
        <div class="nav-group-content">
          <div class="nav-item" data-page="providers">
            <div class="nav-icon"><i class="fas fa-cloud"></i></div>
            <span class="nav-text">Provider AI</span>
            <span class="nav-badge" id="badgeProviders">0</span>
          </div>
        </div>
      </div>

      <!-- PENGETAHUAN & BELAJAR -->
      <div class="nav-group">
        <div class="nav-section" onclick="toggleNavGroup(this)">
          <span class="nav-section-dot"></span>
          <span class="nav-section-text">Pengetahuan & Belajar</span>
          <i class="fas fa-chevron-down nav-section-chevron"></i>
        </div>
        <div class="nav-group-content">
          <div class="nav-item" data-page="knowledge">
            <div class="nav-icon"><i class="fas fa-book"></i></div>
            <span class="nav-text">Pengetahuan</span>
            <span class="nav-badge" id="badgeKnowledge">0</span>
          </div>
          <div class="nav-item" data-page="graph">
            <div class="nav-icon"><i class="fas fa-project-diagram"></i></div>
            <span class="nav-text">Knowledge Graph</span>
            <span class="nav-badge" id="badgeGraph">0</span>
          </div>
          <div class="nav-item" data-page="memory">
            <div class="nav-icon"><i class="fas fa-brain"></i></div>
            <span class="nav-text">Memori AI</span>
            <span class="nav-badge" id="badgeMemory">0</span>
          </div>
        </div>
      </div>

      <!-- MONITORING -->
      <div class="nav-group">
        <div class="nav-section" onclick="toggleNavGroup(this)">
          <span class="nav-section-dot"></span>
          <span class="nav-section-text">Monitoring</span>
          <i class="fas fa-chevron-down nav-section-chevron"></i>
        </div>
        <div class="nav-group-content">
          <div class="nav-item" data-page="inbox">
            <div class="nav-icon"><i class="fas fa-inbox"></i></div>
            <span class="nav-text">Pertanyaan Warga</span>
            <span class="nav-badge nav-badge-danger" id="badgeInbox">0</span>
          </div>
          <div class="nav-item" data-page="feedback">
            <div class="nav-icon"><i class="fas fa-chart-line"></i></div>
            <span class="nav-text">Feedback & Akurasi</span>
          </div>
          <div class="nav-item" data-page="sessions">
            <div class="nav-icon"><i class="fas fa-comments"></i></div>
            <span class="nav-text">Percakapan</span>
            <span class="nav-badge" id="badgeSessions">0</span>
          </div>
          <div class="nav-item" data-page="notifications">
            <div class="nav-icon"><i class="fas fa-bell"></i></div>
            <span class="nav-text">Notifikasi</span>
          </div>
        </div>
      </div>

      <!-- SISTEM -->
      <div class="nav-group">
        <div class="nav-section" onclick="toggleNavGroup(this)">
          <span class="nav-section-dot"></span>
          <span class="nav-section-text">Sistem</span>
          <i class="fas fa-chevron-down nav-section-chevron"></i>
        </div>
        <div class="nav-group-content">
          <div class="nav-item" data-page="backup">
            <div class="nav-icon"><i class="fas fa-database"></i></div>
            <span class="nav-text">Backup</span>
          </div>
          <div class="nav-item" data-page="security">
            <div class="nav-icon"><i class="fas fa-shield-alt"></i></div>
            <span class="nav-text">Keamanan</span>
          </div>
        </div>
      </div>

    </nav>

    <div class="sidebar-footer">
      <div class="admin-info">
        <i class="fas fa-user-circle"></i>
        <span id="adminUsername">admin</span>
      </div>
      <button class="btn-logout-sidebar" onclick="doLogout()">
        <i class="fas fa-sign-out-alt"></i>
        <span>Logout</span>
      </button>
    </div>
  </aside>

  <!-- SIDEBAR OVERLAY (Mobile) -->
  <div class="sidebar-overlay" id="sidebarOverlay" onclick="toggleSidebar()"></div>

  <!-- MAIN CONTENT -->
  <div class="admin-main">

    <!-- HEADER -->
    <header class="main-header">
      <button class="btn-toggle-sidebar" onclick="toggleSidebar()">
        <i class="fas fa-bars"></i>
      </button>
      <h1 class="main-title" id="pageTitle">Dashboard</h1>
      <div class="main-header-right">
        <div class="notif-wrapper">
          <button class="btn-icon notif-bell" onclick="toggleNotifDropdown()">
            <i class="fas fa-bell"></i>
            <span class="notif-badge" id="notifBadge" style="display:none;">0</span>
          </button>
          <div class="notif-dropdown" id="notifDropdown">
            <div class="notif-header">
              <span><i class="fas fa-bell"></i> Notifikasi</span>
              <div class="notif-header-actions">
                <button onclick="markAllRead()" title="Tandai semua dibaca">
                  <i class="fas fa-check-double"></i>
                </button>
                <button onclick="clearNotifications()" title="Hapus semua">
                  <i class="fas fa-trash"></i>
                </button>
              </div>
            </div>
            <div class="notif-body" id="notifBody">
              <div class="notif-empty">Belum ada notifikasi</div>
            </div>
            <div class="notif-footer">
              <a href="#" onclick="showPage('notifications'); return false;">Lihat Semua</a>
            </div>
          </div>
        </div>
      </div>
    </header>

    <!-- CONTENT -->
    <main class="main-content">

      <!-- ============================================================
      PAGE: DASHBOARD
      ============================================================ -->
      <div class="page active" id="page-dashboard">

        <div class="dash-welcome">
          <div class="dash-welcome-text">
            <h1>Selamat Datang di <span id="dashAiName">SIVT AI</span> 👋</h1>
            <p>Dashboard ringkasan semua aktivitas AI Anda</p>
          </div>
          <div class="dash-welcome-meta">
            <i class="fas fa-clock"></i> Uptime: <span id="dashUptime">-</span>
          </div>
        </div>

        <div class="dash-section-title">
          <i class="fas fa-chart-pie"></i> Ringkasan Utama
        </div>
        <div class="stat-grid stat-grid-4">
          <div class="stat-card stat-blue">
            <div class="stat-icon"><i class="fas fa-cloud"></i></div>
            <div class="stat-info">
              <div class="stat-value" id="statProviders">0</div>
              <div class="stat-label">Provider AI</div>
              <div class="stat-sub" id="statProvidersSub">-</div>
            </div>
          </div>
          <div class="stat-card stat-green">
            <div class="stat-icon"><i class="fas fa-book"></i></div>
            <div class="stat-info">
              <div class="stat-value" id="statKnowledge">0</div>
              <div class="stat-label">Chunk Pengetahuan</div>
              <div class="stat-sub" id="statKnowledgeSub">-</div>
            </div>
          </div>
          <div class="stat-card stat-purple">
            <div class="stat-icon"><i class="fas fa-brain"></i></div>
            <div class="stat-info">
              <div class="stat-value" id="statMemory">0</div>
              <div class="stat-label">Memori AI</div>
              <div class="stat-sub" id="statMemorySub">-</div>
            </div>
          </div>
          <div class="stat-card stat-orange">
            <div class="stat-icon"><i class="fas fa-comments"></i></div>
            <div class="stat-info">
              <div class="stat-value" id="statSessions">0</div>
              <div class="stat-label">Sesi Aktif</div>
              <div class="stat-sub" id="statSessionsSub">-</div>
            </div>
          </div>
        </div>

        <div class="dash-section-title">
          <i class="fas fa-brain"></i> Otak AI
        </div>
        <div class="stat-grid stat-grid-4">
          <div class="stat-card stat-teal">
            <div class="stat-icon"><i class="fas fa-circle"></i></div>
            <div class="stat-info">
              <div class="stat-value" id="statGraphNodes">0</div>
              <div class="stat-label">Graph Nodes</div>
              <div class="stat-sub" id="statGraphNodesSub">Dari knowledge base</div>
            </div>
          </div>
          <div class="stat-card stat-teal">
            <div class="stat-icon"><i class="fas fa-link"></i></div>
            <div class="stat-info">
              <div class="stat-value" id="statGraphEdges">0</div>
              <div class="stat-label">Graph Edges</div>
              <div class="stat-sub" id="statGraphEdgesSub">Relasi antar node</div>
            </div>
          </div>
          <div class="stat-card stat-blue">
            <div class="stat-icon"><i class="fas fa-database"></i></div>
            <div class="stat-info">
              <div class="stat-value" id="statRagDocs">0</div>
              <div class="stat-label">RAG BM25 Docs</div>
              <div class="stat-sub" id="statRagDocsSub">-</div>
            </div>
          </div>
          <div class="stat-card stat-purple">
            <div class="stat-icon"><i class="fas fa-vector-square"></i></div>
            <div class="stat-info">
              <div class="stat-value" id="statEmbedding">0</div>
              <div class="stat-label">Embedding Vecs</div>
              <div class="stat-sub" id="statEmbeddingSub">-</div>
            </div>
          </div>
        </div>

        <div class="dash-section-title">
          <i class="fas fa-star"></i> Kualitas Layanan
        </div>
        <div class="stat-grid stat-grid-4">
          <div class="stat-card stat-green">
            <div class="stat-icon"><i class="fas fa-smile"></i></div>
            <div class="stat-info">
              <div class="stat-value" id="statFeedback">0%</div>
              <div class="stat-label">Kepuasan User</div>
              <div class="stat-sub" id="statFeedbackSub">-</div>
            </div>
          </div>
          <div class="stat-card stat-blue">
            <div class="stat-icon"><i class="fas fa-bullseye"></i></div>
            <div class="stat-info">
              <div class="stat-value" id="statAccuracy">0%</div>
              <div class="stat-label">Akurasi Jawaban</div>
              <div class="stat-sub" id="statAccuracySub">-</div>
            </div>
          </div>
          <div class="stat-card stat-orange">
            <div class="stat-icon"><i class="fas fa-question-circle"></i></div>
            <div class="stat-info">
              <div class="stat-value" id="statUnanswered">0</div>
              <div class="stat-label">Tak Terjawab</div>
              <div class="stat-sub" id="statUnansweredSub">-</div>
            </div>
          </div>
          <div class="stat-card stat-pink">
            <div class="stat-icon"><i class="fas fa-bell"></i></div>
            <div class="stat-info">
              <div class="stat-value" id="statNotif">0</div>
              <div class="stat-label">Notifikasi</div>
              <div class="stat-sub" id="statNotifSub">-</div>
            </div>
          </div>
        </div>

        <div class="dash-section-title">
          <i class="fas fa-chart-bar"></i> Aktivitas 7 Hari Terakhir
        </div>
        <div class="card">
          <div class="card-body">
            <div class="chart-wrap" id="chartWrap">
              <div class="empty-state"><i class="fas fa-spinner fa-spin"></i> Memuat data...</div>
            </div>
          </div>
        </div>

        <div class="dash-row">
          <div class="card">
            <div class="card-header"><i class="fas fa-exclamation-triangle"></i> Perlu Perhatian</div>
            <div class="card-body" id="learningHighlight">
              <div class="empty-state">Memuat data...</div>
            </div>
          </div>
          <div class="card">
            <div class="card-header"><i class="fas fa-info-circle"></i> Detail Sistem</div>
            <div class="card-body">
              <div style="margin-bottom:16px;">
                <div style="font-size:12px; font-weight:700; color:var(--gray-dark); margin-bottom:8px; text-transform:uppercase; letter-spacing:0.5px;">Status Provider</div>
                <div class="provider-status-list" id="providerStatusList">
                  <div class="empty-state">Memuat...</div>
                </div>
              </div>
              <div>
                <div style="font-size:12px; font-weight:700; color:var(--gray-dark); margin-bottom:8px; text-transform:uppercase; letter-spacing:0.5px;">RAG Hybrid Stats</div>
                <div id="ragStatsPanel">
                  <div class="empty-state">Memuat...</div>
                </div>
              </div>
            </div>
          </div>
        </div>

      </div>

      <!-- ============================================================
      PAGE: GENERAL
      ============================================================ -->
      <div class="page" id="page-general">
        <div class="card">
          <div class="card-header"><i class="fas fa-cog"></i> Identitas AI</div>
          <div class="card-body">
            <div class="form-grid">
              <div class="form-group">
                <label>Nama AI</label>
                <input type="text" id="cfg-aiName" class="form-input" placeholder="SIVT AI">
              </div>
              <div class="form-group">
                <label>Tagline</label>
                <input type="text" id="cfg-tagline" class="form-input" placeholder="Asisten Virtual Tegalrejo">
              </div>
              <div class="form-group full">
                <label>Pesan Sambutan</label>
                <textarea id="cfg-welcomeMessage" class="form-input" rows="3" placeholder="Halo! Saya SIVT AI..."></textarea>
              </div>
            </div>
          </div>
        </div>

        <div class="card">
          <div class="card-header"><i class="fas fa-address-book"></i> Kontak & Info</div>
          <div class="card-body">
            <div class="form-grid">
              <div class="form-group full">
                <label>Alamat</label>
                <input type="text" id="cfg-contact-address" class="form-input">
              </div>
              <div class="form-group">
                <label>Telepon</label>
                <input type="text" id="cfg-contact-phone" class="form-input">
              </div>
              <div class="form-group">
                <label>WhatsApp</label>
                <input type="text" id="cfg-contact-whatsapp" class="form-input">
              </div>
              <div class="form-group">
                <label>Email</label>
                <input type="email" id="cfg-contact-email" class="form-input">
              </div>
              <div class="form-group">
                <label>Jam Pelayanan</label>
                <input type="text" id="cfg-contact-hours" class="form-input" placeholder="Senin-Jumat 08:00-16:00">
              </div>
            </div>
            <div class="action-bar">
              <button class="btn-primary-lg" onclick="saveGeneral()">
                <i class="fas fa-save"></i> Simpan Pengaturan
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- ============================================================
      PAGE: LOGO
      ============================================================ -->
      <div class="page" id="page-logo">
        <div class="card">
          <div class="card-header"><i class="fas fa-image"></i> Logo Aplikasi</div>
          <div class="card-body">
            <p style="font-size:13px; color:var(--gray-dark); margin-bottom:20px;">
              Upload sekali, otomatis dipakai di chat header, login, sidebar, favicon.
            </p>
            <div class="logo-preview-area">
              <div class="logo-preview-box" id="logoPreviewBox">
                <div class="logo-placeholder">
                  <i class="fas fa-image"></i>
                  <span>Belum ada logo</span>
                </div>
              </div>
              <div class="logo-upload-info">
                <h4>Upload Logo</h4>
                <p>Format: PNG, JPG, GIF, WEBP, SVG. Maksimal 2 MB. Rekomendasi PNG transparan 512×512.</p>
                <input type="file" id="logoFile" accept="image/*" style="display:none;" onchange="uploadLogo()">
                <button class="btn-primary" onclick="document.getElementById('logoFile').click()">
                  <i class="fas fa-upload"></i> Pilih File Logo
                </button>
                <button class="btn-danger-outline" onclick="deleteLogo()">
                  <i class="fas fa-trash"></i> Hapus Logo
                </button>
                <div id="logoStatus" class="status-msg"></div>
              </div>
            </div>
          </div>
        </div>

        <div class="card">
          <div class="card-header"><i class="fas fa-expand"></i> Ukuran Logo</div>
          <div class="card-body">
            <div class="logo-size-options">
              <label class="logo-size-option">
                <input type="radio" name="logoSize" value="small" onchange="changeLogoSize('small')">
                <span>Kecil</span>
              </label>
              <label class="logo-size-option">
                <input type="radio" name="logoSize" value="medium" checked onchange="changeLogoSize('medium')">
                <span>Sedang</span>
              </label>
              <label class="logo-size-option">
                <input type="radio" name="logoSize" value="large" onchange="changeLogoSize('large')">
                <span>Besar</span>
              </label>
              <label class="logo-size-option">
                <input type="radio" name="logoSize" value="xlarge" onchange="changeLogoSize('xlarge')">
                <span>Extra Besar</span>
              </label>
            </div>
          </div>
        </div>
      </div>

      <!-- ============================================================
      PAGE: THEME
      ============================================================ -->
      <div class="page" id="page-theme">
        <div class="card">
          <div class="card-header"><i class="fas fa-palette"></i> Warna Tema Aplikasi</div>
          <div class="card-body">
            <p style="font-size:13px; color:var(--gray-dark); margin-bottom:20px;">
              Ubah warna sesuai selera. Perubahan langsung terlihat setelah disimpan.
            </p>
            <div class="form-grid">
              <div class="form-group">
                <label>Warna Utama (Primary)</label>
                <div class="color-input-row">
                  <input type="color" id="theme-primary" value="#0d47a1" onchange="previewTheme()">
                  <input type="text" id="theme-primary-text" value="#0d47a1" oninput="syncColorFromText('primary')">
                </div>
              </div>
              <div class="form-group">
                <label>Warna Utama Gelap</label>
                <div class="color-input-row">
                  <input type="color" id="theme-primaryDark" value="#0a3a8a" onchange="previewTheme()">
                  <input type="text" id="theme-primaryDark-text" value="#0a3a8a" oninput="syncColorFromText('primaryDark')">
                </div>
              </div>
              <div class="form-group">
                <label>Warna Aksen</label>
                <div class="color-input-row">
                  <input type="color" id="theme-accent" value="#ec4899" onchange="previewTheme()">
                  <input type="text" id="theme-accent-text" value="#ec4899" oninput="syncColorFromText('accent')">
                </div>
              </div>
              <div class="form-group">
                <label>Sidebar Awal</label>
                <div class="color-input-row">
                  <input type="color" id="theme-sidebarStart" value="#0a3a8a" onchange="previewTheme()">
                  <input type="text" id="theme-sidebarStart-text" value="#0a3a8a" oninput="syncColorFromText('sidebarStart')">
                </div>
              </div>
              <div class="form-group">
                <label>Sidebar Akhir</label>
                <div class="color-input-row">
                  <input type="color" id="theme-sidebarEnd" value="#0d47a1" onchange="previewTheme()">
                  <input type="text" id="theme-sidebarEnd-text" value="#0d47a1" oninput="syncColorFromText('sidebarEnd')">
                </div>
              </div>
            </div>

            <div style="margin-top:20px;">
              <label style="font-size:13px; font-weight:600; color:var(--gray-dark); display:block; margin-bottom:10px;">Preset Cepat:</label>
              <div class="preset-buttons">
                <button class="preset-btn" onclick="applyPreset('default')">Biru</button>
                <button class="preset-btn" onclick="applyPreset('dark')">Dark</button>
                <button class="preset-btn" onclick="applyPreset('green')">Hijau</button>
                <button class="preset-btn" onclick="applyPreset('purple')">Ungu</button>
                <button class="preset-btn" onclick="applyPreset('red')">Merah</button>
                <button class="preset-btn" onclick="applyPreset('teal')">Teal</button>
                <button class="preset-btn" onclick="applyPreset('orange')">Orange</button>
              </div>
            </div>

            <div class="action-bar" style="margin-top:24px;">
              <button class="btn-primary-lg" onclick="saveTheme()">
                <i class="fas fa-save"></i> Simpan Tema
              </button>
              <button class="btn-secondary" onclick="resetTheme()">
                <i class="fas fa-undo"></i> Reset
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- ============================================================
      PAGE: PROVIDERS
      ============================================================ -->
      <div class="page" id="page-providers">

        <div class="provider-help">
          <strong><i class="fas fa-info-circle"></i> Panduan Provider Role</strong>
          <p style="margin:8px 0; font-size:13px;">Setiap provider bisa punya role berbeda. Klik badge role di tabel provider untuk toggle.</p>
          <ul>
            <li><strong>chat</strong> — Provider untuk menjawab pertanyaan user (LLM utama)</li>
            <li><strong>embedding</strong> — Provider untuk RAG semantic (ubah teks jadi vector)</li>
            <li><strong>enrichment</strong> — Provider untuk ekstrak triple ke Knowledge Graph</li>
            <li><strong>query-rewriter</strong> — Provider untuk rewrite pertanyaan user</li>
          </ul>
          <p style="margin-top:10px; font-size:12px;"><strong>Saran kombinasi:</strong><br>
            • Gemini: chat + embedding + enrichment (paling fleksibel)<br>
            • Groq: chat + query-rewriter (tercepat)<br>
            • Mistral: chat + enrichment (fallback)</p>
        </div>

        <div class="card">
          <div class="card-header"><i class="fas fa-plus-circle"></i> Tambah Provider AI</div>
          <div class="card-body">
            <p style="font-size:13px; color:var(--gray-dark); margin-bottom:16px;">
              Pilih provider terdaftar, atau tambahkan provider custom dengan <strong>Custom Endpoint</strong> jika ingin pakai provider OpenAI-compatible lainnya.
            </p>

            <div class="filter-tabs">
              <button class="filter-tab active" data-mode="builtin" onclick="switchProviderMode('builtin')">
                <i class="fas fa-cloud"></i> Provider Terdaftar
              </button>
              <button class="filter-tab" data-mode="custom" onclick="switchProviderMode('custom')">
                <i class="fas fa-server"></i> Provider Custom
              </button>
            </div>

            <!-- BUILTIN PROVIDER -->
            <div id="providerMode-builtin">
              <div class="provider-help" style="background:#f0fdf4; border-left-color:var(--success);">
                <strong style="color:#047857;">Cara dapat API key gratis:</strong>
                <ul style="margin-top:8px;">
                  <li>Gemini: <a href="https://aistudio.google.com/app/apikey" target="_blank">aistudio.google.com/app/apikey</a></li>
                  <li>Groq: <a href="https://console.groq.com/keys" target="_blank">console.groq.com/keys</a></li>
                  <li>OpenRouter: <a href="https://openrouter.ai/keys" target="_blank">openrouter.ai/keys</a></li>
                  <li>Cerebras: <a href="https://cloud.cerebras.ai" target="_blank">cloud.cerebras.ai</a></li>
                  <li>Together: <a href="https://api.together.xyz" target="_blank">api.together.xyz</a></li>
                  <li>Mistral: <a href="https://console.mistral.ai" target="_blank">console.mistral.ai</a></li>
                  <li>DeepSeek: <a href="https://platform.deepseek.com" target="_blank">platform.deepseek.com</a></li>
                  <li>xAI Grok: <a href="https://console.x.ai" target="_blank">console.x.ai</a></li>
                </ul>
              </div>

              <div class="form-grid">
                <div class="form-group full">
                  <label>Provider</label>
                  <select id="newProviderName" class="form-input">
                    <option value="gemini">Gemini (Google)</option>
                    <option value="groq">Groq</option>
                    <option value="openrouter">OpenRouter</option>
                    <option value="cerebras">Cerebras</option>
                    <option value="together">Together AI</option>
                    <option value="mistral">Mistral AI</option>
                    <option value="deepseek">DeepSeek</option>
                    <option value="fireworks">Fireworks AI</option>
                    <option value="xai">xAI Grok</option>
                  </select>
                </div>
                <div class="form-group full">
                  <label>API Key</label>
                  <input type="password" id="newProviderKey" class="form-input" placeholder="Masukkan API key">
                </div>
                <div class="form-group full">
                  <label>Role <span style="font-weight:400; font-size:12px;">(bisa pilih lebih dari 1)</span></label>
                  <div class="role-checkbox-row" id="newProviderRoles">
                    <label class="role-checkbox">
                      <input type="checkbox" value="chat" checked>
                      <span class="role-badge chat">chat ✓</span>
                    </label>
                    <label class="role-checkbox">
                      <input type="checkbox" value="embedding">
                      <span class="role-badge embedding inactive">embedding</span>
                    </label>
                    <label class="role-checkbox">
                      <input type="checkbox" value="enrichment">
                      <span class="role-badge enrichment inactive">enrichment</span>
                    </label>
                    <label class="role-checkbox">
                      <input type="checkbox" value="query-rewriter">
                      <span class="role-badge query-rewriter inactive">query-rewriter</span>
                    </label>
                  </div>
                </div>
                <div class="form-group">
                  <label>Models <span style="font-weight:400; font-size:12px;">(pisah koma, kosongkan untuk default)</span></label>
                  <input type="text" id="newProviderModels" class="form-input" placeholder="gemini-2.0-flash, gemini-1.5-pro">
                </div>
                <div class="form-group">
                  <label>Embedding Models <span style="font-weight:400; font-size:12px;">(opsional, pisah koma)</span></label>
                  <input type="text" id="newProviderEmbeddingModels" class="form-input" placeholder="text-embedding-004">
                </div>
              </div>
            </div>

            <!-- CUSTOM PROVIDER -->
            <div id="providerMode-custom" style="display:none;">
              <div class="provider-help" style="background:#fef3c7; border-left-color:#f59e0b;">
                <strong style="color:#92400e;">Provider Custom OpenAI-Compatible:</strong>
                <p style="margin:8px 0; font-size:12px; color:#78350f;">
                  Isi endpoint dengan format <code>https://api.contoh.com/v1</code>.<br>
                  Sistem akan otomatis kirim request ke <code>{endpoint}/chat/completions</code>.
                </p>
              </div>

              <div class="form-grid">
                <div class="form-group">
                  <label>Nama Provider *</label>
                  <input type="text" id="customProviderName" class="form-input" placeholder="my-provider">
                </div>
                <div class="form-group">
                  <label>Display Name</label>
                  <input type="text" id="customProviderDisplay" class="form-input" placeholder="My Custom Provider">
                </div>
                <div class="form-group full">
                  <label>Custom Endpoint *</label>
                  <input type="text" id="customProviderEndpoint" class="form-input" placeholder="https://api.contoh.com/v1">
                </div>
                <div class="form-group full">
                  <label>API Key *</label>
                  <input type="password" id="customProviderKey" class="form-input" placeholder="Masukkan API key">
                </div>
                <div class="form-group full">
                  <label>Role</label>
                  <div class="role-checkbox-row" id="customProviderRoles">
                    <label class="role-checkbox">
                      <input type="checkbox" value="chat" checked>
                      <span class="role-badge chat">chat ✓</span>
                    </label>
                    <label class="role-checkbox">
                      <input type="checkbox" value="embedding">
                      <span class="role-badge embedding inactive">embedding</span>
                    </label>
                    <label class="role-checkbox">
                      <input type="checkbox" value="enrichment">
                      <span class="role-badge enrichment inactive">enrichment</span>
                    </label>
                    <label class="role-checkbox">
                      <input type="checkbox" value="query-rewriter">
                      <span class="role-badge query-rewriter inactive">query-rewriter</span>
                    </label>
                  </div>
                </div>
                <div class="form-group">
                  <label>Models <span style="font-weight:400; font-size:12px;">(pisah koma)</span></label>
                  <input type="text" id="customProviderModels" class="form-input">
                </div>
                <div class="form-group">
                  <label>Embedding Models <span style="font-weight:400; font-size:12px;">(opsional)</span></label>
                  <input type="text" id="customProviderEmbeddingModels" class="form-input">
                </div>
              </div>
            </div>

            <div class="action-bar" style="margin-top:20px;">
              <button class="btn-primary-lg" onclick="addProvider()">
                <i class="fas fa-plus"></i> Tambah Provider
              </button>
              <span id="addProviderStatus" class="status-msg"></span>
            </div>
          </div>
        </div>

        <div class="card">
          <div class="card-header"><i class="fas fa-list"></i> Daftar Provider</div>
          <div class="card-body" id="providersList">
            <div class="empty-state">Belum ada provider</div>
          </div>
        </div>

      </div>

      <!-- ============================================================
      PAGE: PROMPT
      ============================================================ -->
      <div class="page" id="page-prompt">
        <div class="card">
          <div class="card-header"><i class="fas fa-terminal"></i> System Instruction</div>
          <div class="card-body">
            <p style="font-size:13px; color:var(--gray-dark); margin-bottom:16px;">
              Instruksi ini mengatur kepribadian & aturan AI. Semakin ketat aturannya, semakin akurat jawabannya.
            </p>
            <textarea id="cfg-systemInstruction" class="prompt-textarea" rows="15" placeholder="Anda adalah asisten AI untuk Kemantren Tegalrejo..."></textarea>
            <button class="btn-primary-lg" onclick="savePrompt()">
              <i class="fas fa-save"></i> Simpan Prompt
            </button>
          </div>
        </div>

        <div class="card">
          <div class="card-header"><i class="fas fa-poll"></i> Link Survei Kepuasan</div>
          <div class="card-body">
            <p style="font-size:13px; color:var(--gray-dark); margin-bottom:16px;">
              Setelah warga bertanya ke AI dan diam selama waktu di bawah, akan muncul popup "apakah sudah terjawab?" dengan tombol menuju link survei di bawah ini.
            </p>
            <div class="switch-row">
              <label class="switch">
                <input type="checkbox" id="surveyEnabled">
                <span class="slider"></span>
              </label>
              <span>Aktifkan popup survei otomatis</span>
            </div>
            <div class="form-grid">
              <div class="form-group full">
                <label>Link Survei (Google Form, Tally, dll)</label>
                <input type="url" id="cfg-surveyLink" class="form-input" placeholder="https://forms.gle/...">
              </div>
              <div class="form-group">
                <label>Waktu Tunggu Idle (menit)</label>
                <input type="number" id="cfg-surveyIdleMinutes" class="form-input" value="3" min="1" max="30">
              </div>
            </div>
            <div class="provider-help" style="margin-top:16px;">
              <strong>Cara kerja:</strong>
              <ul>
                <li>Warga bertanya ke AI → AI jawab</li>
                <li>Warga diam selama 3 menit (bisa diubah)</li>
                <li>Popup "Sudah terjawab?" muncul di tengah layar</li>
                <li>Warga klik Ya → buka link survei di tab baru</li>
                <li>Warga klik Belum → popup tutup, bisa lanjut tanya</li>
              </ul>
            </div>
            <div class="action-bar" style="margin-top:16px;">
              <button class="btn-primary-lg" onclick="saveSurveyConfig()">
                <i class="fas fa-save"></i> Simpan Pengaturan Survei
              </button>
              <span id="surveyStatus" class="status-msg"></span>
            </div>
          </div>
        </div>
      </div>

      <!-- ============================================================
      PAGE: KNOWLEDGE
      ============================================================ -->
      <div class="page" id="page-knowledge">
        <div class="card">
          <div class="card-header"><i class="fas fa-upload"></i> Upload File Pengetahuan</div>
          <div class="card-body">
            <p style="font-size:13px; color:var(--gray-dark); margin-bottom:16px;">
              Format: .md atau .txt. Setiap topik dipisah baris kosong atau heading <code>##</code>.
            </p>
            <input type="file" id="knowledgeFile" accept=".md,.txt" style="display:none;" onchange="uploadKnowledge()">
            <div class="action-bar">
              <button class="btn-primary" onclick="document.getElementById('knowledgeFile').click()">
                <i class="fas fa-upload"></i> Upload
              </button>
              <button class="btn-secondary" onclick="reloadKnowledge()">
                <i class="fas fa-sync"></i> Reload
              </button>
              <span id="uploadStatus" class="status-msg"></span>
            </div>
          </div>
        </div>

        <div class="card">
          <div class="card-header"><i class="fas fa-file-alt"></i> File Pengetahuan</div>
          <div class="card-body" id="knowledgeFilesList">
            <div class="empty-state">Belum ada file pengetahuan</div>
          </div>
        </div>
      </div>

      <!-- ============================================================
      PAGE: GRAPH
      ============================================================ -->
      <div class="page" id="page-graph">
        <div class="card">
          <div class="card-header"><i class="fas fa-project-diagram"></i> Knowledge Graph Visualization</div>
          <div class="card-body">
            <div class="graph-controls">
              <div class="graph-control-item">
                <label>Jumlah Node (Top N)</label>
                <input type="number" id="graphLimit" value="300" min="10" max="1000">
              </div>
              <div class="graph-control-item">
                <label>Minimal Degree</label>
                <input type="number" id="graphMinDegree" value="1" min="1" max="100">
              </div>
              <div class="graph-control-item">
                <label>Cari Node</label>
                <input type="text" id="graphSearch" placeholder="Ketik nama node...">
              </div>
              <div class="graph-control-item" style="justify-content:flex-end;">
                <button class="btn-primary" onclick="loadGraphVisualization()">
                  <i class="fas fa-sync"></i> Refresh
                </button>
              </div>
            </div>

            <div class="graph-stats" id="graphStats">
              <div class="empty-state"><i class="fas fa-spinner fa-spin"></i> Memuat graph...</div>
            </div>

            <div class="graph-container" id="graphContainer"></div>

            <div class="graph-legend">
              <div class="legend-title">Keterangan:</div>
              <div class="legend-items">
                <span class="legend-item"><span class="legend-dot" style="background:var(--primary);"></span> Node biasa</span>
                <span class="legend-item"><span class="legend-dot" style="background:var(--danger);"></span> Node penting (degree tinggi)</span>
                <span class="legend-item"><span class="legend-dot" style="background:var(--primary); width:20px; height:20px;"></span> Ukuran = Degree</span>
                <span class="legend-item"><span style="display:inline-block; width:30px; height:4px; background:var(--primary); border-radius:2px;"></span> Ketebalan = Bobot</span>
              </div>
            </div>
          </div>
        </div>

        <div class="card" id="graphNodeDetail" style="display:none;">
          <div class="card-header">
            <i class="fas fa-circle"></i> Detail Node: <span id="graphNodeName"></span>
            <button class="modal-close" onclick="closeGraphNodeDetail()" style="margin-left:auto;">
              <i class="fas fa-times"></i>
            </button>
          </div>
          <div class="card-body" id="graphNodeBody"></div>
        </div>

        <div class="card">
          <div class="card-header"><i class="fas fa-magic"></i> Semantic Enrichment (Beta)</div>
          <div class="card-body">
            <div class="enrich-panel">
              <div class="enrich-info">
                <i class="fas fa-lightbulb"></i>
                <div>
                  <strong>Gunakan AI untuk mengekstrak relasi mendalam (triple) dari pengetahuan Anda.</strong>
                  <p>Proses ini memakan token API dan berjalan di background.</p>
                </div>
              </div>
              <div class="enrich-actions">
                <label style="font-size:12px; font-weight:600;">Max Chunks:</label>
                <input type="number" id="enrichMaxChunks" value="30" min="1" max="100">
                <button class="btn-primary" id="enrichBtn" onclick="startEnrich()">
                  <i class="fas fa-play"></i> Mulai Enrich
                </button>
              </div>
              <div class="enrich-status" id="enrichStatus"></div>
            </div>
          </div>
        </div>
      </div>

      <!-- ============================================================
      PAGE: INBOX (Pertanyaan Warga)
      ============================================================ -->
      <div class="page" id="page-inbox">
        <div class="card">
          <div class="card-header">
            <i class="fas fa-inbox"></i> Pertanyaan Warga
          </div>
          <div class="card-body">
            <div class="unified-info-box">
              <i class="fas fa-info-circle"></i>
              <div>
                <strong>Fitur Terpadu: Saat Anda jawab di sini, otomatis juga akan:</strong>
                <ul>
                  <li>✅ Masuk ke Buku Pengetahuan</li>
                  <li>✅ Update Knowledge Graph</li>
                  <li>✅ Tandai resolved di kedua antrian</li>
                  <li>✅ Tambah edge semantic via AI</li>
                </ul>
              </div>
            </div>

            <div class="filter-tabs">
              <button class="filter-tab active" data-inbox-tab="all" onclick="switchInboxTab('all')">
                <i class="fas fa-list"></i> Semua
                <span class="filter-count" id="inboxTabAllCount">0</span>
              </button>
              <button class="filter-tab" data-inbox-tab="priority" onclick="switchInboxTab('priority')">
                <i class="fas fa-fire"></i> Prioritas
                <span class="filter-count" id="inboxTabPriorityCount">0</span>
              </button>
            </div>

            <div class="stat-grid stat-grid-4" id="inboxStats" style="display:none;">
              <div class="stat-card stat-blue">
                <div class="stat-info">
                  <div class="stat-value" id="inboxStatTotal">0</div>
                  <div class="stat-label">Total Antrian</div>
                </div>
              </div>
              <div class="stat-card stat-orange">
                <div class="stat-info">
                  <div class="stat-value" id="inboxStatPending">0</div>
                  <div class="stat-label">Pending</div>
                </div>
              </div>
              <div class="stat-card stat-red">
                <div class="stat-info">
                  <div class="stat-value" id="inboxStatUrgent">0</div>
                  <div class="stat-label">Urgent</div>
                </div>
              </div>
              <div class="stat-card stat-green">
                <div class="stat-info">
                  <div class="stat-value" id="inboxStatResolved">0</div>
                  <div class="stat-label">Selesai</div>
                </div>
              </div>
            </div>

            <div class="action-bar" style="margin-bottom:16px;">
              <button class="btn-secondary" onclick="loadPertanyaanWarga()">
                <i class="fas fa-sync"></i> Refresh
              </button>
              <button class="btn-secondary" onclick="clearInboxResolved()">
                <i class="fas fa-broom"></i> Hapus Yang Selesai
              </button>
              <button class="btn-danger-outline" onclick="clearInboxAll()">
                <i class="fas fa-trash"></i> Hapus Semua
              </button>
            </div>

            <div id="inboxList">
              <div class="empty-state"><i class="fas fa-spinner fa-spin"></i></div>
            </div>
          </div>
        </div>
      </div>

      <!-- ============================================================
      PAGE: FEEDBACK
      ============================================================ -->
      <div class="page" id="page-feedback">
        <div class="card">
          <div class="card-header"><i class="fas fa-chart-line"></i> Feedback & Akurasi AI</div>
          <div class="card-body">
            <p style="font-size:13px; color:var(--gray-dark); margin-bottom:20px;">
              Statistik kepuasan user dan akurasi jawaban AI. Semakin tinggi, semakin pintar AI Anda.
            </p>

            <div class="stat-grid stat-grid-4">
              <div class="stat-card stat-blue">
                <div class="stat-info">
                  <div class="stat-value" id="fbTotal">0</div>
                  <div class="stat-label">Total Feedback</div>
                </div>
              </div>
              <div class="stat-card stat-green">
                <div class="stat-info">
                  <div class="stat-value" id="fbGood">0</div>
                  <div class="stat-label">Bagus 👍</div>
                </div>
              </div>
              <div class="stat-card stat-red">
                <div class="stat-info">
                  <div class="stat-value" id="fbBad">0</div>
                  <div class="stat-label">Kurang 👎</div>
                </div>
              </div>
              <div class="stat-card stat-purple">
                <div class="stat-info">
                  <div class="stat-value" id="fbSatisfaction">0%</div>
                  <div class="stat-label">Kepuasan</div>
                </div>
              </div>
            </div>

            <div class="dash-section-title" style="margin-top:24px;">
              <i class="fas fa-chart-bar"></i> Analytics
            </div>
            <div class="stat-grid stat-grid-4">
              <div class="stat-card stat-blue">
                <div class="stat-info">
                  <div class="stat-value" id="anTotalChats">0</div>
                  <div class="stat-label">Total Chat</div>
                </div>
              </div>
              <div class="stat-card stat-green">
                <div class="stat-info">
                  <div class="stat-value" id="anTotalAnswers">0</div>
                  <div class="stat-label">Jawaban Diberikan</div>
                </div>
              </div>
              <div class="stat-card stat-red">
                <div class="stat-info">
                  <div class="stat-value" id="anRefusals">0</div>
                  <div class="stat-label">Penolakan</div>
                </div>
              </div>
              <div class="stat-card stat-purple">
                <div class="stat-info">
                  <div class="stat-value" id="anAccuracy">0%</div>
                  <div class="stat-label">Akurasi</div>
                </div>
              </div>
              <div class="stat-card stat-teal">
                <div class="stat-info">
                  <div class="stat-value" id="anMemoryHits">0</div>
                  <div class="stat-label">Memory Hits</div>
                </div>
              </div>
              <div class="stat-card stat-orange">
                <div class="stat-info">
                  <div class="stat-value" id="anRagHits">0</div>
                  <div class="stat-label">RAG Hits</div>
                </div>
              </div>
              <div class="stat-card stat-pink">
                <div class="stat-info">
                  <div class="stat-value" id="anOutOfScope">0</div>
                  <div class="stat-label">Out of Scope</div>
                </div>
              </div>
            </div>

            <div class="dash-row" style="margin-top:24px;">
              <div class="card">
                <div class="card-header"><i class="fas fa-smile"></i> Kepuasan User</div>
                <div class="card-body">
                  <div class="chart-wrap-pie" id="feedbackPieChart">
                    <div class="empty-state">Memuat data...</div>
                  </div>
                </div>
              </div>
              <div class="card">
                <div class="card-header"><i class="fas fa-chart-line"></i> Tren Feedback 7 Hari Terakhir</div>
                <div class="card-body">
                  <div class="chart-wrap" id="feedbackChart">
                    <div class="empty-state">Memuat data...</div>
                  </div>
                </div>
              </div>
            </div>

            <div class="filter-tabs" style="margin-top:24px;">
              <button class="filter-tab active" data-filter="all" onclick="filterFeedback('all')">
                <i class="fas fa-list"></i> Semua
              </button>
              <button class="filter-tab" data-filter="good" onclick="filterFeedback('good')">
                <i class="fas fa-thumbs-up"></i> Bagus
              </button>
              <button class="filter-tab" data-filter="bad" onclick="filterFeedback('bad')">
                <i class="fas fa-thumbs-down"></i> Kurang
              </button>
            </div>

            <div class="action-bar">
              <button class="btn-secondary" onclick="loadFeedback()">
                <i class="fas fa-sync"></i> Refresh
              </button>
              <button class="btn-danger-outline" onclick="clearFeedback()">
                <i class="fas fa-trash"></i> Hapus Feedback
              </button>
              <button class="btn-danger-outline" onclick="clearAnalytics()">
                <i class="fas fa-undo"></i> Reset Analytics
              </button>
            </div>

            <div id="feedbackList" style="margin-top:20px;">
              <div class="empty-state"><i class="fas fa-spinner fa-spin"></i></div>
            </div>
          </div>
        </div>
      </div>

      <!-- ============================================================
      PAGE: MEMORY (LAYOUT BARU — Konteks di Atas)
      ============================================================ -->
      <div class="page" id="page-memory">

        <!-- ROW 1: Pengaturan + Konteks (2 kolom sejajar) -->
        <div class="memory-top-row">

          <!-- Pengaturan Memori -->
          <div class="card">
            <div class="card-header"><i class="fas fa-brain"></i> Pengaturan Memori</div>
            <div class="card-body">
              <div class="switch-row">
                <label class="switch">
                  <input type="checkbox" id="memoryEnabled" checked>
                  <span class="slider"></span>
                </label>
                <span>Aktifkan memori otomatis</span>
              </div>
              <div class="form-grid">
                <div class="form-group">
                  <label>Min skor pakai memori <span style="font-weight:400; font-size:12px;">(default 75)</span></label>
                  <input type="number" id="memoryMinScore" class="form-input" value="75" min="0" max="100">
                </div>
                <div class="form-group">
                  <label>Min skor simpan baru <span style="font-weight:400; font-size:12px;">(default 55)</span></label>
                  <input type="number" id="memorySaveThreshold" class="form-input" value="55" min="0" max="100">
                </div>
              </div>
              <div class="action-bar">
                <button class="btn-primary-lg" onclick="saveMemorySettings()">
                  <i class="fas fa-save"></i> Simpan
                </button>
                <button class="btn-secondary" onclick="reloadMemory()">
                  <i class="fas fa-sync"></i> Reload
                </button>
                <button class="btn-danger-outline" onclick="clearMemory()">
                  <i class="fas fa-trash"></i> Hapus Semua
                </button>
              </div>
            </div>
          </div>

          <!-- Konteks Percakapan (DIPINDAH KE ATAS - SEJAJAR) -->
          <div class="card">
            <div class="card-header"><i class="fas fa-comments"></i> Konteks Percakapan</div>
            <div class="card-body">
              <div class="switch-row">
                <label class="switch">
                  <input type="checkbox" id="convEnabled" checked>
                  <span class="slider"></span>
                </label>
                <span>Aktifkan konteks percakapan</span>
              </div>
              <div class="form-grid">
                <div class="form-group">
                  <label>Jumlah pesan diingat</label>
                  <input type="number" id="convSize" class="form-input" value="20" min="5" max="50">
                </div>
                <div class="form-group">
                  <label>Rate limit per-sesi (pesan/menit)</label>
                  <input type="number" id="rateLimitPerSession" class="form-input" value="20" min="5" max="100">
                </div>
              </div>
              <div class="action-bar">
                <button class="btn-primary-lg" onclick="saveConversationSettings()">
                  <i class="fas fa-save"></i> Simpan
                </button>
              </div>
            </div>
          </div>

        </div>

        <!-- ROW 2: Daftar Memori (Full width) -->
        <div class="card">
          <div class="card-header">
            <i class="fas fa-list"></i> Daftar Memori
            <div style="margin-left:auto; display:flex; gap:8px;">
              <button class="btn-secondary btn-sm" onclick="loadMemoryList()">
                <i class="fas fa-sync"></i> Refresh
              </button>
            </div>
          </div>
          <div class="card-body" id="memoryList">
            <div class="empty-state"><i class="fas fa-spinner fa-spin"></i></div>
          </div>
        </div>

      </div>

      <!-- ============================================================
      PAGE: SESSIONS
      ============================================================ -->
      <div class="page" id="page-sessions">
        <div class="card">
          <div class="card-header"><i class="fas fa-comments"></i> Percakapan Aktif</div>
          <div class="card-body">
            <p style="font-size:13px; color:var(--gray-dark); margin-bottom:16px;">
              Sesi percakapan (2 jam terakhir).
            </p>
            <div class="action-bar" style="margin-bottom:16px;">
              <button class="btn-secondary" onclick="loadSessions()">
                <i class="fas fa-sync"></i> Refresh
              </button>
              <button class="btn-danger-outline" onclick="clearSessions()">
                <i class="fas fa-trash"></i> Hapus Semua
              </button>
            </div>
            <div id="sessionsList">
              <div class="empty-state"><i class="fas fa-spinner fa-spin"></i></div>
            </div>
          </div>
        </div>
      </div>

      <!-- ============================================================
      PAGE: NOTIFICATIONS
      ============================================================ -->
      <div class="page" id="page-notifications">
        <div class="card">
          <div class="card-header"><i class="fas fa-bell"></i> Notifikasi Sistem</div>
          <div class="card-body">
            <div class="action-bar" style="margin-bottom:16px;">
              <button class="btn-secondary" onclick="loadNotifications()">
                <i class="fas fa-sync"></i> Refresh
              </button>
              <button class="btn-secondary" onclick="markAllRead()">
                <i class="fas fa-check-double"></i> Tandai Dibaca
              </button>
              <button class="btn-danger-outline" onclick="clearNotifications()">
                <i class="fas fa-trash"></i> Hapus
              </button>
            </div>
            <div id="notificationsList">
              <div class="empty-state"><i class="fas fa-spinner fa-spin"></i></div>
            </div>
          </div>
        </div>
      </div>

      <!-- ============================================================
      PAGE: BACKUP
      ============================================================ -->
      <div class="page" id="page-backup">
        <div class="card">
          <div class="card-header"><i class="fas fa-database"></i> Backup Otomatis</div>
          <div class="card-body">
            <p style="font-size:13px; color:var(--gray-dark); margin-bottom:16px;">
              Backup otomatis setiap hari jam 02.00. File dienkripsi AES-256.<br>
              Termasuk knowledge graph & embedding cache. Retensi: 4 hari terakhir.
            </p>
            <div class="action-bar" style="margin-bottom:20px;">
              <button class="btn-primary-lg" onclick="runBackupNow()">
                <i class="fas fa-download"></i> Backup Sekarang
              </button>
              <button class="btn-secondary" onclick="loadBackups()">
                <i class="fas fa-sync"></i> Refresh Daftar
              </button>
            </div>
            <div id="backupsList">
              <div class="empty-state"><i class="fas fa-spinner fa-spin"></i></div>
            </div>
          </div>
        </div>

        <div class="card">
          <div class="card-header"><i class="fas fa-upload"></i> Restore dari Backup</div>
          <div class="card-body">
            <div class="restore-warning">
              <i class="fas fa-exclamation-triangle"></i>
              <div>
                <strong>⚠️ PERHATIAN</strong>
                <p>Restore akan MENIMPA data yang ada sekarang dengan data dari file backup.<br>
                  Data lama akan di-backup ke folder <code>pre_restore_*</code> sebagai cadangan.</p>
              </div>
            </div>
            <input type="file" id="restoreFile" accept=".zip.enc" style="display:none;">
            <div class="action-bar">
              <button class="btn-primary" onclick="document.getElementById('restoreFile').click()">
                <i class="fas fa-file-archive"></i> Pilih File Backup (.zip.enc)
              </button>
              <button class="btn-danger-outline" id="restoreBtn" onclick="startRestore()">
                <i class="fas fa-upload"></i> Mulai Restore
              </button>
            </div>
            <div id="restoreStatus" class="restore-status"></div>
          </div>
        </div>
      </div>

      <!-- ============================================================
      PAGE: SECURITY
      ============================================================ -->
      <div class="page" id="page-security">
        <div class="card">
          <div class="card-header"><i class="fas fa-key"></i> Ganti Password Admin</div>
          <div class="card-body">
            <div class="form-grid">
              <div class="form-group">
                <label>Password Lama</label>
                <input type="password" id="oldPassword" class="form-input">
              </div>
              <div class="form-group">
                <label>Password Baru (min 8 karakter)</label>
                <input type="password" id="newPassword" class="form-input">
              </div>
            </div>
            <div class="action-bar">
              <button class="btn-primary-lg" onclick="changePassword()">
                <i class="fas fa-save"></i> Ganti Password
              </button>
              <span id="passwordStatus" class="status-msg"></span>
            </div>
          </div>
        </div>

        <div class="card">
          <div class="card-header"><i class="fas fa-shield-alt"></i> Info Keamanan</div>
          <div class="card-body">
            <ul class="info-list">
              <li><i class="fas fa-check-circle" style="color:var(--success);"></i> Login pakai JWT (30 hari) + bcrypt</li>
              <li><i class="fas fa-check-circle" style="color:var(--success);"></i> Sesi login tersimpan</li>
              <li><i class="fas fa-check-circle" style="color:var(--success);"></i> API key terenkripsi AES-256-GCM</li>
              <li><i class="fas fa-check-circle" style="color:var(--success);"></i> Backup dienkripsi AES-256</li>
              <li><i class="fas fa-check-circle" style="color:var(--success);"></i> Multi-provider dengan fallback otomatis</li>
              <li><i class="fas fa-check-circle" style="color:var(--success);"></i> Provider Role System (chat/embedding/enrichment/query-rewriter)</li>
              <li><i class="fas fa-check-circle" style="color:var(--success);"></i> RAG Hybrid (BM25 + Embedding + RRF)</li>
              <li><i class="fas fa-check-circle" style="color:var(--success);"></i> Query Rewriting otomatis</li>
              <li><i class="fas fa-check-circle" style="color:var(--success);"></i> Unified Learning Pipeline</li>
              <li><i class="fas fa-check-circle" style="color:var(--success);"></i> Knowledge Graph (Graph RAG) aktif</li>
            </ul>
          </div>
        </div>
      </div>

    </main>
  </div>
</div>

<!-- ============================================================
MODAL: ANSWER (Unified Pipeline)
============================================================ -->
<div class="modal-overlay" id="answerModal" onclick="closeAnswerModal(event)">
  <div class="modal-card">
    <div class="modal-header">
      <h3><i class="fas fa-plus-circle"></i> Pertanyaan Warga</h3>
      <button class="modal-close" onclick="closeAnswerModal()"><i class="fas fa-times"></i></button>
    </div>
    <div class="modal-body">
      <input type="hidden" id="modal-id">
      <input type="hidden" id="modal-source">

      <div class="form-group">
        <label>Pertanyaan Warga</label>
        <input type="text" id="modal-question" class="form-input" readonly style="background:var(--gray-light);">
      </div>
      <div class="form-group">
        <label>Kategori (opsional)</label>
        <input type="text" id="modal-category" class="form-input" placeholder="Contoh: Administrasi, Infrastruktur">
      </div>
      <div class="form-group">
        <label>Jawaban Lengkap *</label>
        <textarea id="modal-answer" class="form-input" rows="6" placeholder="Tulis jawaban lengkap di sini..."></textarea>
      </div>

      <div id="modalPipelineStatus" class="pipeline-status"></div>
    </div>
    <div class="modal-footer">
      <button class="btn-secondary" onclick="closeAnswerModal()">
        <i class="fas fa-times"></i> Batal
      </button>
      <button class="btn-primary-lg" id="modalSubmitBtn" onclick="submitAnswerToKnowledge()">
        <i class="fas fa-save"></i> Simpan & Update Semua
      </button>
    </div>
  </div>
</div>

<!-- ============================================================
MODAL: EDIT MEMORY (BARU)
============================================================ -->
<div class="modal-overlay" id="editMemoryModal" onclick="closeEditMemory(event)">
  <div class="modal-card" style="max-width:700px;">
    <div class="modal-header">
      <h3><i class="fas fa-edit"></i> Edit Memori</h3>
      <button class="modal-close" onclick="closeEditMemory()"><i class="fas fa-times"></i></button>
    </div>
    <div class="modal-body">
      <input type="hidden" id="editMemoryIndex">

      <div class="form-group">
        <label>Pertanyaan <span style="color:var(--danger);">*</span></label>
        <input type="text" id="editMemoryQuestion" class="form-input">
      </div>

      <div class="form-group">
        <label>Jawaban <span style="color:var(--danger);">*</span></label>
        <textarea id="editMemoryAnswer" class="form-input" rows="6"></textarea>
      </div>

      <div class="form-group">
        <label>Variasi Pertanyaan <span style="font-weight:400; font-size:12px;">(pisah koma)</span></label>
        <input type="text" id="editMemoryVariants" class="form-input" placeholder="variasi 1, variasi 2, variasi 3">
      </div>

      <div class="form-group">
        <label>Keywords <span style="font-weight:400; font-size:12px;">(pisah koma)</span></label>
        <input type="text" id="editMemoryKeywords" class="form-input" placeholder="ktp, syarat, administrasi">
      </div>
    </div>
    <div class="modal-footer">
      <button class="btn-secondary" onclick="closeEditMemory()">
        <i class="fas fa-times"></i> Batal
      </button>
      <button class="btn-primary-lg" id="editMemorySaveBtn" onclick="saveEditMemory()">
        <i class="fas fa-save"></i> Simpan Perubahan
      </button>
    </div>
  </div>
</div>

<script src="/admin/script.js"></script>

</body>
</html>