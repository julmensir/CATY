# ============================================
# ENVIRONMENT
# ============================================
NODE_ENV=production
PORT=3000
USE_DB=true

# ============================================
# ADMIN CREDENTIALS
# ============================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=PASTE_HASH_LANGKAH_4_DI_SINI

# ============================================
# JWT SECRET (WAJIB — min 32 karakter)
# ============================================
JWT_SECRET=PASTE_HASIL_LANGKAH_2_DI_SINI

# ============================================
# ENCRYPTION KEY (WAJIB — 64 karakter hex)
# ============================================
ENCRYPTION_KEY=PASTE_HASIL_LANGKAH_3_DI_SINI

# ============================================
# POSTGRESQL (WAJIB)
# ============================================
PGHOST=localhost
PGPORT=5432
PGDATABASE=db_caty
PGUSER=postgres
PGPASSWORD=PASSWORD_POSTGRES_ANDA

# ============================================
# BACKUP
# ============================================
BACKUP_KEEP_COUNT=4
BACKUP_MAX_FILE_SIZE_MB=50