<<<<<<< HEAD:.env.example
# ============================================
# ADMIN CREDENTIALS
# ============================================
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# ============================================
# JWT SECRET (WAJIB diganti kalau belum)
# ============================================
JWT_SECRET=

# ============================================
# ENCRYPTION KEY (WAJIB — 64 karakter hex)
# ============================================
# Generate dengan:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# JANGAN PERNAH GANTI NILAI INI setelah ada data terenkripsi!
ENCRYPTION_KEY=

# ============================================
# BACKUP PASSWORD (opsional, untuk enkripsi ZIP tambahan)
# ============================================
BACKUP_PASSWORD=

# ============================================
# ENVIRONMENT
# ============================================
NODE_ENV=production
PORT=3000

# ============================================================
# BACKUP RETENTION
# ============================================================
# Simpan 4 file backup terbaru (4 hari terakhir)
BACKUP_KEEP_COUNT=4

# Ukuran maksimal 1 file backup (MB)
BACKUP_MAX_FILE_SIZE_MB=50

# PostgreSQL
PGHOST=localhost
PGPORT=5432
PGDATABASE=db_caty
PGUSER=postgres
PGPASSWORD=
USE_DB=true