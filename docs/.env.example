# ============================================================
# CATY — Contoh konfigurasi (.env)
# Salin jadi .env lalu isi. JANGAN commit file .env ke Git.
# ============================================================

# --- Server ---
PORT=3000
# Isi "production" di server asli (cookie login jadi "secure", wajib HTTPS)
NODE_ENV=development

# --- Keamanan (WAJIB) ---
# JWT_SECRET: minimal 32 karakter acak
# ENCRYPTION_KEY: tepat 64 karakter hex (32 byte)
# Buat keduanya dengan:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=ganti_dengan_string_acak_minimal_32_karakter
ENCRYPTION_KEY=ganti_dengan_64_karakter_hex

# --- Akun admin ---
ADMIN_USERNAME=admin
# Disarankan: hash bcrypt (diawali $2). Buat dengan:
#   node -e "require('bcrypt').hash('PasswordKuat!',10).then(console.log)"
ADMIN_PASSWORD_HASH=
# Alternatif (kurang aman): password polos, di-hash saat server start.
# Jika hash dan password sama-sama kosong, server memakai "admin123" (JANGAN di produksi).
# ADMIN_PASSWORD=

# --- Database (opsional, sangat disarankan) ---
# false = mode file. Feedback, analytics, dan learning queue NONAKTIF.
USE_DB=true

# Pilihan A: connection string (SSL otomatis aktif)
# DATABASE_URL=postgres://user:password@host:5432/db_caty
# Pilihan B: variabel terpisah
PGHOST=localhost
PGPORT=5432
PGDATABASE=db_caty
PGUSER=postgres
PGPASSWORD=

# --- Backup ---
# Jumlah file backup terbaru yang disimpan
BACKUP_KEEP_COUNT=4
